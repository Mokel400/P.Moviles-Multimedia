<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="elementos.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            

            <Label
                Text="Nombre de Ususario"
                FontSize="18"
                FontAttributes="Bold"
                SemanticProperties.HeadingLevel="Level1" />

            <Entry
                x:Name="correoEntry"
                Placeholder="correo@ejemplo.com"
                Keyboard="Email"
                MaxLength="50"/>

            <Editor
                x:Name="comentariosEditor"
                Placeholder="Escribe tus comentarios"
                Keyboard="Text"
                AutoSize="TextChanges"
                MaxLength="300"
                HeightRequest="120"/>

            <Button
                x:Name="formBtn"
                Text="Enviar"
                Clicked="FormBtnClicked"
                HorizontalOptions="Fill" />

            <Image
                Source="multimedia.jpeg"
                Aspect="AspectFill"/>

            <CheckBox
                x:Name="condicionesCheckBox"
                Color="DarkBlue"/>
            
            <Label 
                Text="Acepto las condiciones"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
